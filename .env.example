# =============================================================================
# LATAM Social — variables de entorno
# Copiar a .env y completar. NUNCA subir .env al repositorio (docs/03 §8).
# =============================================================================

APP_NAME="LATAM Social"
APP_ENV=local                 # local | development | qa | staging | production
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es_PE
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=UTC              # SIEMPRE UTC en almacenamiento (docs/03 §5). La zona
                              # del usuario se aplica al renderizar, no al guardar.

# --- Base de datos --------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=latam_social
DB_USERNAME=root
DB_PASSWORD=

# El usuario de la aplicación NO debe tener UPDATE/DELETE sobre audit_logs
# (BR-SEC-003). Crear un usuario separado para migraciones.
DB_MIGRATION_USERNAME=
DB_MIGRATION_PASSWORD=

# --- Cache, colas y sesión ------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false   # true obligatorio en producción
SESSION_SAME_SITE=lax

# --- Almacenamiento (DEC-008: S3-compatible, nunca disco local) -----------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=                 # Cloudflare R2 o Backblaze B2: egreso barato,
AWS_USE_PATH_STYLE_ENDPOINT=true   # y los clientes van a descargar vídeo

# --- Correo ---------------------------------------------------------------
# ATENCIÓN (docs/16 §3): Google Workspace tiene límites de envío y no está
# pensado para correo transaccional. Usar un proveedor dedicado para lo
# transaccional y dejar Workspace para el correo humano.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-responder@latamsocial.com"
MAIL_FROM_NAME="${APP_NAME}"

# Fuera de producción el correo SIEMPRE pasa por un capturador (BR-INT-005).
MAIL_SAFETY_CATCHER=log

# --- Clave maestra de credenciales de integraciones (DEC-030) -------------
# Cifrado sobre: vive FUERA de la base de datos. Rotarla recifra las claves
# de datos, no las filas.
INTEGRATIONS_MASTER_KEY=

# --- Ambiente de integraciones (DEC-029) ----------------------------------
# El resolver LANZA EXCEPCIÓN si no coincide con el ambiente de la conexión.
# No es un filtro: es una barrera. Impide emitir comprobantes reales desde QA.
INTEGRATIONS_ENVIRONMENT=sandbox   # sandbox | production

# --- SUNAT · facturación electrónica Perú (CTS Perú) ----------------------
SUNAT_ENVIRONMENT=beta             # beta | produccion
SUNAT_RUC=20603203896
SUNAT_SOL_USER=
SUNAT_SOL_PASS=
SUNAT_CERT_PATH=                   # certificado digital .pfx, fuera del repo
SUNAT_CERT_PASSWORD=

# --- DIAN · facturación electrónica Colombia (CTS Colombia) ---------------
DIAN_ENVIRONMENT=habilitacion      # habilitacion | produccion
DIAN_NIT=
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_TEST_SET_ID=
DIAN_CERT_PATH=
DIAN_CERT_PASSWORD=

# --- Tipo de cambio · Decolecta -------------------------------------------
DECOLECTA_TOKEN=
DECOLECTA_BASE_URL=https://api.decolecta.com

# --- Observabilidad -------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
SENTRY_LARAVEL_DSN=
