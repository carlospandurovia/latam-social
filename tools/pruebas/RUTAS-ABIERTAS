# Las rutas que NO exigen ningun permiso, y por que.
#
# Una linea por ruta, con su motivo detras del `#`. `verificar-muro.py`
# comprueba que esta lista, `routes/web.php` y la constante `ABIERTAS` de
# `MuroTest` digan las tres lo mismo: una ruta nueva sin `permiso:` que no
# aparezca aqui pone el CI en rojo.
#
# Existe porque hoy nada distinguia «es publica a proposito» de «se le olvido el
# middleware a alguien», y el fallo que de verdad paso en este proyecto --`5.9`,
# la portada enseñando los totales internos a cualquier autenticado-- es
# exactamente ese. Escribir el motivo obliga a pensarlo una vez; leerlo permite
# discutirlo despues.

# --- Antes de entrar: no hay sesion todavia -------------------------------
acceso                  # el formulario de acceso
entrar                  # y su envio, con throttle:5,1
recuperar               # pedir enlace de recuperacion
recuperar.enviar        # su envio, con throttle:5,1 y la misma respuesta exista o no el correo
recuperar.usar          # abrir el enlace, con throttle:20,1
recuperar.formulario    # elegir la contrasena nueva
recuperar.fijar         # guardarla, con throttle:10,1

# --- La marca, antes de entrar (9.17) -------------------------------------
#
# El logotipo sale en la pantalla de acceso, que la ve quien no ha entrado. No
# hay permiso que exigir. Lo que las protege es que NO aceptan identificador:
# sirven el logotipo y el favicon de la marca por defecto y nada mas.
marca.logo              # el logotipo de la marca por defecto
marca.favicon           # y el icono de la pestana; si no hay, se sirve el logotipo

# --- Dentro, pero sin permiso: son de CUALQUIER autenticado ---------------
salir                   # cerrar sesion
panel                   # la portada; lo que enseña depende del permiso, no la ruta (5.9)
contrasena              # cambiar la propia contrasena
contrasena.cambiar      # y guardarla

# --- El muro de los terminos (9.19) -------------------------------------
#
# La pantalla a la que lleva el muro y su envio. Sin permiso a proposito: es lo
# unico que puede abrir un creador que ya no puede abrir nada mas, y ponerle uno
# dejaria sin salida justo a quien la necesita. La autorizacion es tener una
# ficha de creador atada a la sesion, y la comprueba el controlador.
terminos.mios           # leer los terminos vigentes y ver en que situacion estas
terminos.aceptar        # aceptarlos, con throttle:10,1

# --- Enlaces FIRMADOS: la defensa es la firma, no el rol ------------------
#
# Quien entra por aqui no tiene cuenta --un creador invitado, un cliente que
# aprueba una pieza-- asi que no hay permiso que exigirle. Lo que hay es un
# enlace de un solo uso con caducidad, y su throttle.
invitacion.ver          # 7.6, throttle:20,1
invitacion.oferta       # la oferta, sin presupuesto ni margen (BR-SEC-001)
invitacion.aceptar      # throttle:10,1
invitacion.rechazar     # throttle:10,1
invitacion.preguntar    # 7.6b, throttle:5,1
invitacion.gracias      # pantalla final
invitacion.caducada     # y la del enlace vencido
aprobacion.ver          # 8.5, throttle:20,1
aprobacion.pieza        # la pieza, sin un solo importe
aprobacion.responder    # throttle:10,1
aprobacion.gracias      # pantalla final
aprobacion.caducada     # y la del enlace vencido

# 9.21b -- La calle. Son publicas porque ese es su trabajo: si pidieran sesion
# no servirian para nada.
portada.marcas          # la portada, para marcas
portada.creadores       # la portada, para creadores
portada.gracias         # el «gracias» de la postulacion
postular                # 9.21b, throttle:5,1 + campo trampa; escribe en creator_applications
contacto                # 9.21c, throttle:5,1 + campo trampa; escribe en client_leads
contacto.gracias        # pantalla final
