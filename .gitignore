/.phpunit.cache
/node_modules
# `/public/build` NO se ignora (DEC-303): el servidor no tiene Node, asi que
# el CSS y el JS compilados viajan por el repositorio. `/public/hot` SI se
# ignora y es importante que siga asi: es el marcador del Vite de desarrollo,
# y en el servidor haria que todos los estilos se pidan a localhost:5173.
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed

# --- LATAM Social ---------------------------------------------------------
# Salida derivada: la regenera `python3 tools/generar-triggers.py`. Versionarla
# invita a que alguien edite el trigger generado en vez del esquema de origen.
/tools/sql/generado

# Cache de Deptrac. Es un artefacto de la ultima ejecucion local: versionarlo
# hace que el analisis de un desarrollador dependa de lo que analizo otro.
/.deptrac.cache

# Salida local de `php tools/diagnostico.php`. Es el resultado de la ultima
# ejecucion en UNA maquina: versionarla solo produce conflictos en cada diff.
/tools/diagnostico.txt
/tools/ci-github.txt
/ci.txt

# Cuarentena. Las herramientas remotas no pueden borrar archivos en tu disco,
# asi que lo que hay que eliminar se mueve aqui y lo borras tu.
/_to_delete

# Rutas del contenedor de trabajo, nunca del proyecto
/stage
/.entrega
